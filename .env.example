# Neon pooled PostgreSQL URL. Keep sslmode=verify-full for TLS verification.
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=verify-full
# Direct Neon URL for migrations (optional; defaults to DATABASE_URL).
DATABASE_URL_UNPOOLED=
# Canonical origin, no trailing slash. HTTPS in production.
BETTER_AUTH_URL=http://127.0.0.1:3000
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET=
# Optional CLI-only values; otherwise setup commands prompt securely.
MONI_SETUP_EMAIL=
MONI_SETUP_PASSWORD=
